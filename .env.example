# ===============================================
# AnyVideoDownloader Configuration
# ===============================================

# Server Port
PORT=5000

# Administrator-Supplied YouTube Cookies File
# Store outside the web directory with restricted 0600 permissions.
# Example: /home/ptmm/.config/anyvideodownloader/youtube_cookies.txt
YOUTUBE_COOKIES_PATH=/home/ptmm/.config/anyvideodownloader/youtube_cookies.txt

# Multi-User Concurrency & Rate Limiting
MAX_CONCURRENT_DOWNLOADS=3
RATE_LIMIT_PER_MINUTE=20

# Video Length Limits (in seconds, 10800 = 3 hours)
MAX_DURATION_SECONDS=10800

# Automated File Cleanup (in seconds)
# CLEANUP_INTERVAL_SECONDS: Frequency of cleanup check (900 = 15 minutes)
# CLEANUP_FILE_MAX_AGE_SECONDS: Maximum age of downloaded file before deletion (3600 = 1 hour)
CLEANUP_INTERVAL_SECONDS=900
CLEANUP_FILE_MAX_AGE_SECONDS=3600
